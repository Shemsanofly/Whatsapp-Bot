AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

DATABASE_URL=file:./dev.db

PORT=3000
NODE_ENV=development

WHATSAPP_AUTH_DIR=.whatsapp-auth
AGENT_WHATSAPP_NUMBER=
ALLOWED_WHATSAPP_NUMBERS=
WHATSAPP_REPLY_TO_ALL=true
WHATSAPP_PROCESS_FROM_ME_COMMANDS=false
WHATSAPP_FROM_ME_COMMAND_PREFIX=/agent
# Groups: off = ignore groups, mention = reply when @mentioned, replied to, or the message starts with the prefix, all = reply to every group message
WHATSAPP_GROUP_REPLY_MODE=mention
WHATSAPP_GROUP_COMMAND_PREFIX=/hawa
# Skip messages older than this (avoids replying to backlog after reconnecting). 0 disables.
WHATSAPP_MAX_MESSAGE_AGE_SECONDS=300
# Max agent replies per public sender per minute. 0 disables.
WHATSAPP_PUBLIC_RATE_LIMIT_PER_MINUTE=10

TIMEZONE=Africa/Dar_es_Salaam

GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=primary
